<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Nút chính: nâu, cao 52dp (đặt layout_height="52dp" trong layout), bo 16dp -->
    <style name="Widget.GiaPha.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/button_primary_bg</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Nút phụ: viền nâu, nền trong -->
    <style name="Widget.GiaPha.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/brown_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/brown_primary</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <!-- Nút nguy hiểm (xóa, chặn, cấm) -->
    <style name="Widget.GiaPha.Button.Danger" parent="Widget.GiaPha.Button.Primary">
        <item name="backgroundTint">@color/danger</item>
    </style>

    <!-- Nút chữ (ví dụ "Đăng nhập" ở cuối màn hình) -->
    <style name="Widget.GiaPha.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/brown_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Ô nhập: trắng, bo 16dp, cao 52dp -->
    <style name="Widget.GiaPha.Input" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:maxLines">1</item>
        <item name="android:inputType">text</item>
    </style>

</resources>