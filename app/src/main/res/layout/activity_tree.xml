<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <include
        android:id="@+id/appBar"
        layout="@layout/view_app_bar" />

    <!-- Dải "Đang lọc N đời · Bỏ lọc": chỉ hiện khi đang lọc số đời -->
    <LinearLayout
        android:id="@+id/bandFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/peach_light"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvFilterInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/be_vietnam_pro_semibold"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvFilterClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:minHeight="40dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="16dp"
            android:text="Bỏ lọc"
            android:textColor="@color/brown_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.example.giapha.tree.TreeViewport
            android:id="@+id/viewport"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_screen" />

        <com.example.giapha.ui.common.StateView
            android:id="@+id/stateView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Chỉ Admin và Quản lý thấy; ẩn mặc định, bật theo vai trò sau khi tải -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:fontFamily="@font/be_vietnam_pro_semibold"
            android:text="Thêm thành viên"
            android:textColor="@color/white"
            android:visibility="gone"
            app:backgroundTint="@color/brown_primary"
            app:icon="@drawable/ic_add"
            app:iconTint="@color/white" />
    </FrameLayout>
</LinearLayout>