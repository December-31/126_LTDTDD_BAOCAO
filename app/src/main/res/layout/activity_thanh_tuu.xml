<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <include
        android:id="@+id/appBar"
        layout="@layout/view_app_bar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:visibility="gone">

            <!-- Đệm đáy 96dp để nút nổi không che thẻ cuối -->
            <LinearLayout
                android:id="@+id/listThanhTuu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="96dp" />
        </ScrollView>

        <!-- Trống: hình + một dòng; nút chỉ Admin/Quản lý thấy -->
        <LinearLayout
            android:id="@+id/emptyBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_empty_achievement" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:text="Chưa có thành tựu nào"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddEmpty"
                style="@style/Widget.GiaPha.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:minHeight="48dp"
                android:text="Thêm thành tựu"
                android:visibility="gone"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconTint="@color/white" />
        </LinearLayout>

        <com.example.giapha.ui.common.StateView
            android:id="@+id/stateView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:fontFamily="@font/be_vietnam_pro_semibold"
            android:text="Thêm thành tựu"
            android:textColor="@color/white"
            android:visibility="gone"
            app:backgroundTint="@color/brown_primary"
            app:icon="@drawable/ic_add"
            app:iconTint="@color/white" />
    </FrameLayout>
</LinearLayout>
