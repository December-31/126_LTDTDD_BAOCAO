<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical"
    android:padding="24dp">

    <include
        android:id="@+id/appBar"
        layout="@layout/view_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_input"
        android:hint="Tên hiển thị"
        android:inputType="textPersonName"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint" />

    <TextView
        android:id="@+id/tvNameError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="Vui lòng nhập tên"
        android:textColor="@color/danger"
        android:textSize="12sp"
        android:visibility="gone" />

    <include
        android:id="@+id/phoneInput"
        layout="@layout/view_phone_input"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvPhoneError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:textColor="@color/danger"
        android:textSize="12sp"
        android:visibility="gone" />

    <include
        android:id="@+id/otpBlock"
        layout="@layout/view_otp_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSend"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Gửi mã xác nhận" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Xác nhận đăng ký"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvGoLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:text="Đã có tài khoản? Đăng nhập"
        android:textColor="@color/brown_primary"
        android:textSize="14sp" />

</LinearLayout>