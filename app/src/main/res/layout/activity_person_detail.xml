<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <include
        android:id="@+id/appBar"
        layout="@layout/view_app_bar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Ảnh đại diện lớn -->
                <FrameLayout
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center_horizontal">

                    <TextView
                        android:id="@+id/tvAvatar"
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_green"
                        android:fontFamily="@font/be_vietnam_pro_bold"
                        android:gravity="center"
                        android:textColor="@color/brown_primary"
                        android:textSize="44sp" />

                    <FrameLayout
                        android:id="@+id/ivCrown"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="top|start"
                        android:background="@drawable/bg_circle_gold"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="Trưởng tộc"
                            android:src="@drawable/ic_crown" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btnEditAvatar"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_circle_brown"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="Đổi ảnh đại diện"
                            android:src="@drawable/ic_edit" />
                    </FrameLayout>
                </FrameLayout>

                <!-- Thông tin cơ bản -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/be_vietnam_pro_bold"
                        android:text="Thông tin cơ bản"
                        android:textColor="@color/brown_primary"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:id="@+id/infoRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- Quan hệ gia đình -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/be_vietnam_pro_bold"
                        android:text="Quan hệ gia đình"
                        android:textColor="@color/brown_primary"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:id="@+id/relationGroups"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- Hai nút quản lý quan hệ (Admin, Quản lý) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnParents"
                    style="@style/Widget.GiaPha.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="Quản lý quan hệ cha/mẹ" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMarriage"
                    style="@style/Widget.GiaPha.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="Quản lý quan hệ hôn nhân" />

                <!-- Mục điều hướng -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/rowBio"
                        layout="@layout/item_nav_row" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/peach_light" />

                    <include
                        android:id="@+id/rowAchievements"
                        layout="@layout/item_nav_row" />
                </LinearLayout>

                <!-- Khối quản trị (Admin, Quản lý) -->
                <LinearLayout
                    android:id="@+id/adminBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.GiaPha.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quản trị" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDeath"
                        style="@style/Widget.GiaPha.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChief"
                        style="@style/Widget.GiaPha.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDelete"
                        style="@style/Widget.GiaPha.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:text="Xóa Ô này"
                        android:textColor="@color/danger" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <com.example.giapha.ui.common.StateView
            android:id="@+id/stateView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</LinearLayout>
